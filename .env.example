# ── Sentinel-RCA Environment Variables ──────────────────────────────
# Copy to .env and fill in real values:  cp .env.example .env

# Deployment environment (local | staging | prod)
ENV=local

# Neon Postgres (Required — no default)
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_rca

# Upstash Redis (Required — no default)
REDIS_URL=redis://localhost:6379/0

# HMAC-SHA256 secret shared with your webhook source
WEBHOOK_SECRET=change-me-to-a-real-secret

# Primary LLM provider (Groq)
GROQ_API_KEY=
PRIMARY_LLM_MODEL=groq/llama-3.3-70b-versatile

# Fallback LLM provider (Gemini via LiteLLM)
GEMINI_API_KEY=
FALLBACK_LLM_MODEL=gemini/gemini-2.5-flash

# Rate limits
GROQ_DAILY_LIMIT=30
RATE_LIMIT_PER_HOUR=5

# GitHub repository integration for git_mcp (cloud-native)
GITHUB_TOKEN=
GITHUB_REPO=octocat/victim-service

# Optional: MCP auth token for Streamable HTTP transport
MCP_AUTH_TOKEN=
