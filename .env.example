# ── Sentinel-RCA Environment Variables ──────────────────────────────
# Copy to .env and fill in real values:  cp .env.example .env

# HMAC-SHA256 secret shared with your Sentry webhook configuration
WEBHOOK_SECRET=change-me-to-a-real-secret

# Redis (used for storm-suppression / deduplication)
REDIS_URL=redis://localhost:6379/0

# Postgres with pgvector extension
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_rca

# Set to "true" to route triage LLM calls to a local Ollama instance
# Set to "false" (or omit) to use a hosted API model
USE_LOCAL_OLLAMA=true
