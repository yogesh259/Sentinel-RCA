# Copy to .env and fill in:  cp .env.example .env
GEMINI_API_KEY=
GROQ_API_KEY=
# Needed only to open draft PRs (repo scope on the target repo)
GITHUB_TOKEN=

# true = show the PR that would be opened instead of opening it
DRY_RUN=true
# true on the public deployment: forces DRY_RUN and enforces the daily budget
PUBLIC_DEMO=false
DAILY_BUDGET_USD=2
